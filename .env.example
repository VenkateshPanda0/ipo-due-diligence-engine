# Environment variables — IPO Due Diligence Engine
# Copy to .env and adjust. NEVER commit .env. Every value below has a safe local default;
# the engine needs no paid API, cloud service or LLM credential.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# "production" disables the interactive /docs and /redoc pages
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Persistence (SQLite by default; migrations run automatically at startup)
# ---------------------------------------------------------------------------
DATABASE_URL=sqlite:///./data/ipo_due_diligence.db
# uploaded PDFs (content-addressed) and temp files
DATA_DIR=./data
RETAIN_DOCUMENTS=true
# stored PDFs are purged after this; metadata, hashes and audit remain
RETENTION_DAYS=90

# ---------------------------------------------------------------------------
# Authentication (optional). With no keys configured the API runs as a local
# single-user principal. Keys are mapped to roles server-side:
#   API_KEYS=<user_id>|<role>|<key or sha256=<hex digest>>,...
#   roles: viewer < analyst < reviewer < admin
# Prefer sha256= digests so plaintext keys are not stored in configuration.
# ---------------------------------------------------------------------------
API_KEYS=
# legacy single key, maps to an analyst principal
API_KEY=

# ---------------------------------------------------------------------------
# Regulatory
# ---------------------------------------------------------------------------
RULESET_VERSION=2.0.0
# Keep false until a qualified securities-law professional has reviewed the rules.
REGULATORY_VALIDATION_CONFIRMED=false
REGULATORY_VALIDATION_REFERENCE=

# ---------------------------------------------------------------------------
# Document processing limits
# ---------------------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=50
MAX_PDF_PAGES=1500
# requires the tesseract binary; skipped gracefully if absent
OCR_ENABLED=true
MAX_OCR_PAGES=60
OCR_DPI=200
PROCESSING_TIMEOUT_S=900
WORKER_THREADS=2
UPLOAD_RATE_LIMIT_PER_MINUTE=30
