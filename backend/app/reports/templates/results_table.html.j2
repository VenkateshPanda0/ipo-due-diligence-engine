<table>
  <thead>
    <tr><th>Rule</th><th>Result</th><th>Provision / basis</th><th>Required</th><th>Observed</th><th>Explanation &amp; calculation</th></tr>
  </thead>
  <tbody>
    {% for result in results %}
    <tr>
      <td><strong>{{ result.rule_name or result.description }}</strong><br><code>{{ result.rule_id }}</code>{% if result.rule_version %} v{{ result.rule_version }}{% endif %}
        {% if result.legal_category %}<br><span class="muted">{{ result.legal_category.value|replace("_", " ") }}</span>{% endif %}</td>
      <td>{{ result.verdict|format_verdict }}{% if result.requires_human_review %}<br><span class="muted">review flagged</span>{% endif %}</td>
      <td>{{ result.regulation_reference }}{% if result.verification_status %}<br><span class="muted">source: {{ result.verification_status.value|replace("_", " ") }}</span>{% endif %}
        {% if result.source_url %}<br><a href="{{ result.source_url }}" rel="noopener noreferrer">source</a>{% endif %}</td>
      <td>{{ result.required_value }}</td>
      <td>{{ result.actual_value or "N/A" }}{% if result.gap %}<br><span class="muted">Gap: {{ result.gap }}</span>{% endif %}</td>
      <td>{{ result.explanation }}
        {% if result.calculation %}<ul class="muted">{% for c in result.calculation %}<li>{{ c }}</li>{% endfor %}</ul>{% endif %}
        {% if result.missing_inputs %}<p class="muted">Missing: {{ result.missing_inputs|join(", ") }}</p>{% endif %}
        {% if result.review_reasons %}<p class="muted">Review: {{ result.review_reasons|join("; ") }}</p>{% endif %}
      </td>
    </tr>
    {% endfor %}
  </tbody>
</table>
