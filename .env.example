# Environment Variables — IPO Due Diligence Engine
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# ---------------------------------------------------------------------------
# AI Extraction (required for PDF pipeline; not needed for JSON-only input)
# ---------------------------------------------------------------------------

# Anthropic API key for Claude-based extraction
ANTHROPIC_API_KEY=

# OpenAI API key (optional — Anthropic preferred)
OPENAI_API_KEY=

# Timeout in seconds for AI API calls
AI_EXTRACTION_TIMEOUT_S=30

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# PostgreSQL connection string for storing screening runs and reports
DATABASE_URL=postgresql://postgres:password@localhost:5432/ipo_engine

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

# Application environment: "development" or "production"
APP_ENV=development

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Current ruleset version (controls which rules are active)
RULESET_VERSION=1.0.0

# Bearer token required for /screen, /reports, and /rules when configured
API_KEY=

# Set to true only after documented legal/regulatory sign-off
REGULATORY_VALIDATION_CONFIRMED=false

# Link or identifier for the validation memo/sign-off record
REGULATORY_VALIDATION_REFERENCE=

# Allowed CORS origins (comma-separated, e.g., http://localhost:3000)
CORS_ORIGINS=http://localhost:3000

# Maximum PDF upload size in megabytes
MAX_UPLOAD_SIZE_MB=50
